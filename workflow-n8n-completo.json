      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet telefone = input.phone || input.from || \"\";\ntelefone = String(telefone).replace(/[^0-9]/g, \"\");\nif (telefone.startsWith(\"55\") && telefone.length > 10) telefone = telefone.substring(2);\nconst nome = input.name || input.pushname || \"Paciente\";\nconst mensagem = (input.text || input.body || input.mensagem || \"\").toLowerCase().trim();\nreturn [{ json: { telefone, nome, mensagem } }];"
      },
