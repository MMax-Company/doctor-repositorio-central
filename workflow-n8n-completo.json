    {
      "parameters": {
        "jsCode": "const msg = $json.mensagem;\nlet resposta = \"\";\nif (msg === \"1\" || msg === \"sim\") resposta = `✅ *Inicie sua consulta*\\n🔗 https://typebot.co/doctor-prescreve-8rmljgu`;\nelse if (msg === \"2\" || msg === \"ajuda\") resposta = `📞 *Suporte*\\nResponderemos em até 2h`;\nelse resposta = `❓ Digite:\\n1 - Iniciar\\n2 - Suporte`;\nreturn [{ json: { telefone: $json.telefone, resposta } }];"
      },
