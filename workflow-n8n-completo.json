      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst dados = raw.body || raw.data || raw;\nlet telefone = String(dados.whatsapp || dados.telefone || \"\").replace(/[^0-9]/g, \"\");\nif (!telefone.startsWith(\"55\")) telefone = \"55\" + telefone;\nlet dataNascimento = dados.data_nascimento || \"\";\nif (dataNascimento && dataNascimento.includes(\"/\")) {\n  const p = dataNascimento.split(\"/\");\n  dataNascimento = `${p[2]}-${p[1]}-${p[0]}`;\n}\nlet doencas = dados.doencas || dados.doenca_cronica || [];\nif (typeof doencas === \"string\") doencas = doencas.split(\",\").map(d => d.trim());\nconst isElegivel = (dados.sinaisAlerta || dados.sinais_alerta || \"NAO\") === \"NAO\" && doencas.length > 0;\nreturn [{\n  json: {\n    elegivel: isElegivel,\n    paciente: {\n      nome: dados.nome || dados.Nome_Completo || \"\",\n      cpf: dados.cpf || dados.cpf_paciente || \"\",\n      telefone: telefone,\n      email: dados.email || dados.Email || \"\",\n      data_nascimento: dataNascimento,\n      endereco: dados.endereco || dados.Endereco || \"\"\n    },\n    triagem: {\n      doencas: doencas,\n      medicamento: dados.medicamento || dados.primeiro_medicamento || \"\",\n      medicamento2: dados.medicamento2 || dados.segundo_medicamento || \"\",\n      tempo_uso: dados.tempoUso || dados.tempo_uso || \"\",\n      sinais_alerta: dados.sinaisAlerta || dados.sinais_alerta || \"NAO\"\n    }\n  }\n}];"
      },
